# Copy this file to `.secret` and fill in your real key.
# Solver keys — used to solve the Cloudflare Turnstile challenge.
# A provider is picked by `solver_provider` (or env SOLVER_PROVIDER);
# "auto" tries providers in SOLVER_PRIORITY order (solvercf -> nslsolver -> solvegate).

# SolverCF API key(s) (CapMonster-compatible) — https://solvercf.com
# Multiple keys, comma-separated: when one runs out of credit the next is used
# automatically. A single `solvercf_key=` also works (legacy).
solvercf_keys=PASTE_KEY_1_HERE,PASTE_KEY_2_HERE

# NSLSolver API key — https://nslsolver.com (top-up is crypto-only, 100 free requests)
nslsolver_key=PASTE_YOUR_NSLSOLVER_API_KEY_HERE

# SolveGate API key — https://solvegate.io
solvegate_key=PASTE_YOUR_SOLVEGATE_API_KEY_HERE

# Which provider to use: solvercf | nslsolver | solvegate | auto
solver_provider=solvercf

# Optional: use a fixed email domain instead of random cfmail domains.
# Leave empty/unset to keep using cfmail tempmail (random domain).
# Equivalent CLI flag: ./run.sh --email-domain gmail.com
email_domain=
